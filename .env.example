# GitHub handle whose portfolio the dashboard renders.
GITHUB_USER=StanislavBG

# Public-facing display name. Anonymizes the dashboard while GITHUB_USER stays
# the real login (so the API sync and repo links keep working). Defaults to the
# built-in persona if unset.
GITHUB_DISPLAY_NAME=Bilko Bibitkov

# Optional Personal Access Token. Without one you get 60 req/hour from the
# GitHub REST API; with one you get 5000. A read-only `public_repo` scope is
# enough for public-data scans.
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
