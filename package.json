{
  "name": "git-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Personal GitHub portfolio dashboard — editorial-dark, heatmap-centric, locally-pipelined.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/emit-manifest.mjs",
    "preview": "vite preview",
    "sync": "tsx pipeline/sync.ts",
    "typecheck": "tsc --noEmit",
    "build:lib": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@octokit/rest": "^21.0.2",
    "p-limit": "^6.1.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^6.4.2"
  },
  "packageManager": "pnpm@9.12.0",
  "main": "dist-lib/pipeline/index.js",
  "types": "dist-lib/pipeline/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/pipeline/index.d.ts",
      "import": "./dist-lib/pipeline/index.js"
    }
  },
  "files": [
    "dist-lib",
    "LICENSE"
  ]
}
